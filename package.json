{
  "name": "vowpool",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*",
    "apps/*",
    "cre/workflows/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:shared": "vitest run packages/shared/test",
    "test:program": "bun test tests/program",
    "dev": "bun --cwd apps/web dev",
    "build": "bun --cwd apps/web build",
    "test:web": "vitest run apps/web/test",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@solana/web3.js": "1.98.4",
    "@solana/spl-token": "0.4.14",
    "@noble/hashes": "1.8.0",
    "zod": "3.25.76",
    "bs58": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "litesvm": "0.6.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
