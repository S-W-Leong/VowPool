# Server only; never prefix credentials with NEXT_PUBLIC_
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
VOWPOOL_DATABASE_PATH=.data/vowpool.db
# Export actual public configuration after Devnet bootstrap
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_VOWPOOL_GROUP=
# CRE CLI consumes a disposable key file opaquely; no key contents in source
CRE_SOLANA_PRIVATE_KEY=
# Server-only utility payer path. Signs test-token grants and permissionless refunds;
# never member actions. Use the existing Devnet deployer key file locally.
VOWPOOL_DEMO_PAYER_KEY_PATH=
